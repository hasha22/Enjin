  m_Script: {fileID: 11500000, guid: cfbb24d7071b4ad459a7ae40510e8f2a, type: 3}
  m_Name: The Production Manager
  m_EditorClassIdentifier: Assembly-CSharp::Character
  characterName: ProductionManager
  characterDescription: "You care about results, deadlines, and keeping production
    running smoothly. To you, Enjin is neither a miracle nor a threat \u2014 it is
    a tool, and tools are only useful when they make work more reliable and efficient.
    If Enjin slows teams down you question whether it belongs in the workflow at
    all.\n\nThink about operational efficiency, consistency, and risk management.
    How much automation is too much? When does AI improve productivity, and when
    does it create bottlenecks or quality issues? Get in character!"
  characterImage: {fileID: -545790305699178266, guid: d4f7e6bc0b38da14f8164758ad612f3e, type: 3}
